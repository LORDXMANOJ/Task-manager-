# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
# Local (npm run db:local): postgresql://taskflow:taskflow@localhost:5433/taskflow
# Neon/Supabase: use the connection string from the dashboard (add ?sslmode=require)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5433/taskflow

# ─── Auth ─────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# Frontend origin(s), comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173

# Number of proxies in front of the server (Render/Railway: 1, local: 0)
TRUST_PROXY=0

# ─── Email (optional) ─────────────────────────────────────
# Without RESEND_API_KEY, password-reset links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=TaskFlow <onboarding@resend.dev>
